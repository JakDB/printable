# Copy this file to .env.local and fill in real credentials.
# Never commit .env.local or real secrets.

# Local ICC/API server
ICC_SERVER_HOST=127.0.0.1
ICC_SERVER_PORT=8787

# APIXO image generation
APIXO_BASE_URL=https://api.apixo.ai
APIXO_IMAGE_MODEL=gpt-image-2
APIXO_API_KEY=replace-with-your-apixo-api-key

# MinIO / S3 temporary image upload
MINIO_ENDPOINT=http://your-minio-host:9000
MINIO_PUBLIC_URL=https://your-public-minio-proxy.example.com
MINIO_ACCESS_KEY=replace-with-your-minio-access-key
MINIO_SECRET_KEY=replace-with-your-minio-secret-key
MINIO_BUCKET=printable
MINIO_REGION=us-east-1
MINIO_TEMP_IMAGE_TTL_SECONDS=3600

# S3-compatible aliases, used as fallback by the server
S3_ENDPOINT=http://your-minio-host:9000
S3_ACCESS_KEY_ID=replace-with-your-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-your-minio-secret-key
S3_BUCKET=printable
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
